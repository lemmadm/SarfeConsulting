    "schedule.html": {
      "settings": {
        "title": "Schedule an Appointment | Sarfe Consulting",
        "order": 3,
        "html_before": "<meta name=\"description\" content=\"Schedule an appointment with Sarfe Consulting today. Our team is ready to assist you with customized accounting solutions.\">\n<meta name=\"keywords\" content=\"book appointment, schedule consultation, accounting services booking, Sarfe Consulting booking, accounting experts\">",
        "meta_descr": "Book a convenient time with Sarfe Consulting’s experts to discuss your accounting and financial needs. Let us help you make informed financial decisions."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              }
            },
