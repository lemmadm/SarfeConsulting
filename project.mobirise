    "business-advisory.html": {
      "settings": {
        "title": "Business Advisory | Sarfe Consulting",
        "order": 9,
        "meta_descr": "Sarfe Consulting’s business advisory services provide expert insights and strategic guidance to help businesses overcome challenges, capitalize on opportunities, and achieve long-term success.",
        "html_before": "<meta name=\"description\" content=\"Sarfe Consulting offers expert business advisory services to help you overcome challenges and unlock growth potential with strategic insights.\">\n<meta name=\"keywords\" content=\"business advisory, strategic guidance, business growth, Sarfe Consulting, business consulting\">\n<link rel=\"canonical\" href=\"https://www.sarfeconsulting.com/business-advisory\">"
      },
      "components": [
        {
          "alias": false,
