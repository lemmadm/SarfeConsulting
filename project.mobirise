    "accounting-system-setup.html": {
      "settings": {
        "title": "Accounting System Set-Up | Sarfe Consulting",
        "order": 6,
        "meta_descr": "Sarfe Consulting provides expert accounting system set-up services to streamline financial operations. We help you implement efficient, secure, and user-friendly systems that suit your business needs.",
        "html_before": "<meta name=\"description\" content=\"Set up your accounting system with Sarfe Consulting. Our team ensures a seamless and secure system set-up tailored to your business’s financial needs.\">\n<meta name=\"keywords\" content=\"accounting system setup, financial system setup, secure accounting systems, Sarfe Consulting, business accounting setup\">\n<link rel=\"canonical\" href=\"https://www.sarfeconsulting.com/accounting-system-setup\">"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              }
            },
