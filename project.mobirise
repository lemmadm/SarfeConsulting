    "tax-preparation.html": {
      "settings": {
        "title": "Tax Preparation | Sarfe Consulting",
        "order": 11,
        "meta_descr": "Sarfe Consulting offers expert tax preparation services for individuals and businesses, ensuring compliance and optimizing tax savings. Stay stress-free during tax season with our support.",
        "html_before": "<meta name=\"description\" content=\"Expert tax preparation services by Sarfe Consulting. Let us handle your taxes efficiently and maximize your tax savings with full compliance.\">\n<meta name=\"keywords\" content=\"tax preparation, tax filing, business taxes, individual taxes, Sarfe Consulting, tax compliance\">\n<link rel=\"canonical\" href=\"https://www.sarfeconsulting.com/tax-preparation\">"
      },
