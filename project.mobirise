    "services.html": {
      "settings": {
        "title": "Our Services | Sarfe Consulting",
        "order": 4,
        "html_before": "<meta name=\"description\" content=\"Discover Sarfe Consulting’s award-winning services, including bookkeeping, payroll, auditing, and more. We’re committed to helping you achieve financial growth.\">\n<meta name=\"keywords\" content=\"accounting services, bookkeeping, payroll services, auditing, financial solutions, Sarfe Consulting services, business accounting\">",
        "meta_descr": "Explore Sarfe Consulting’s comprehensive accounting services for businesses and individuals. From bookkeeping to payroll management, we provide secure, reliable, and award-winning solutions."
      },
