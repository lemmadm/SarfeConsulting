    "payroll-accounting.html": {
      "settings": {
        "title": "Payroll Accounting | Sarfe Consulting",
        "order": 10,
        "meta_descr": "Sarfe Consulting simplifies payroll accounting, ensuring timely and accurate payroll processing. Let us manage your payroll, so you can focus on your business.",
        "html_before": "<meta name=\"description\" content=\"Reliable payroll accounting services by Sarfe Consulting. Ensure timely payroll processing and compliance, with accuracy you can trust.\">\n<meta name=\"keywords\" content=\"payroll accounting, payroll processing, employee payroll, Sarfe Consulting, payroll compliance\">\n<link rel=\"canonical\" href=\"https://www.sarfeconsulting.com/payroll-accounting\">"
      },
